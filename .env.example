# Build-time switches. Copy to `.env.local` (dev) or `.env.production` (build).

# Serve the API from the in-browser mock. Set to false once a real API exists —
# the app will then talk to /api on the serving origin and nothing is ephemeral.
VITE_USE_MOCK_API=true

# The synthetic role switcher in the header. Defaults to on in dev, off in
# production builds. It is a preview device and never a security control.
VITE_ENABLE_ROLE_PREVIEW=true

# ── Server / database ────────────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`.
PORT=3001
NODE_ENV=development

# aaPanel MySQL. Localhost-only, so the API must run on the same server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=marketingcrm
DB_USER=MarketingCRM
DB_PASSWORD=MarketingCRM

# At least 32 characters of real randomness. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

SESSION_TTL_HOURS=12
INVITE_TTL_HOURS=72

# Where the browser app is served from. Used to build invite links.
APP_ORIGIN=http://localhost:5173

# Set true once served over HTTPS. Defaults to true in production.
# COOKIE_SECURE=true

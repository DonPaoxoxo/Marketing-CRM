{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "server/**/*.ts",

    "src/lib/types.ts",
    "src/lib/utils.ts",
    "src/lib/rules.ts",
    "src/lib/growth.ts",
    "src/lib/search.ts",
    "src/lib/sanitize.ts",
    "src/lib/permissions.ts",
    "src/lib/integrity.ts",
    "src/lib/csv.ts",
    "src/mocks/seed.ts"
  ]
}
